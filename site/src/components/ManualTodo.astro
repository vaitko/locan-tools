---
/**
 * Owner-only callout listing first-hand material to add by hand (screenshots, embeds, own data).
 * Rendered only when PUBLIC_SHOW_TODOS=true (local preview); production builds emit nothing,
 * but the text is still collected into docs/MANUAL-TODO.md by `npm run todos`.
 */
import { SITE } from '../data/site';

interface Props {
  title?: string;
}
const { title = 'Owner TODO' } = Astro.props;
---

{
  SITE.showTodos && (
    <aside class="my-6 rounded-xl border-2 border-dashed border-warning bg-warning-tint p-4 text-[15px] text-ink not-prose" data-manual-todo>
      <p class="mb-1 text-xs font-extrabold uppercase tracking-wider text-warning">{title}</p>
      <div class="[&_ul]:list-disc [&_ul]:pl-5 [&_li]:mt-1">
        <slot />
      </div>
    </aside>
  )
}
