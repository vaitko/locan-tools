---
import type { Tool } from '../data/tools';
import { toolUrl, guideUrl, TOOL_BY_SLUG } from '../data/tools';
import { getCollection } from 'astro:content';
import { PILLARS } from '../data/pillars';
import { SITE, absUrl } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs, { breadcrumbSchema } from './Breadcrumbs.astro';
import TrustTags from './TrustTags.astro';
import Faq, { faqSchema } from './Faq.astro';
import ToolCard from './ToolCard.astro';
import GuideCard from './GuideCard.astro';
import EmailCapture from './EmailCapture.astro';
import Icon from './Icon.astro';

interface Props {
  tool: Tool;
  /** extra tailwind classes for the form card container */
  formClass?: string;
}
const { tool, formClass = 'max-w-3xl' } = Astro.props;

const path = toolUrl(tool.slug);
const title = `Free ${tool.name} — Local SEO Tool | ${SITE.name}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Free local SEO tools', href: '/tools/' },
  { name: tool.shortName, href: path },
];

const guides = await getCollection('guides', ({ data }) => !data.draft);
const guideBySlug = new Map(guides.map((g) => [g.id, g]));
const relatedGuides = [tool.primaryGuide, ...tool.relatedGuides].map((s) => guideBySlug.get(s)).filter(Boolean).slice(0, 5);
const primaryGuide = guideBySlug.get(tool.primaryGuide);
const relatedTools = tool.relatedTools.map((s) => TOOL_BY_SLUG[s]).filter(Boolean);
const pillar = PILLARS[tool.pillar];

const schema = [
  breadcrumbSchema(crumbs),
  faqSchema(tool.faq),
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `${tool.name} by ${SITE.name}`,
    url: absUrl(path),
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: tool.description,
    featureList: tool.outputs,
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];
---

<BaseLayout title={title} description={tool.description} path={path} schema={schema}>
  <section class="relative overflow-hidden">
    <div class="container-x pt-8">
      <Breadcrumbs items={crumbs} />
    </div>
    <div class="container-x pb-10 pt-8 text-center">
      <TrustTags class="justify-center" />
      <h1 class="h1 mx-auto mt-6 max-w-4xl">Free {tool.name}</h1>
      <p class="lead mx-auto mt-5 max-w-3xl">{tool.intro}</p>
      <p class="mt-4 text-sm text-muted">
        Part of our <a href={`/tools/#${tool.pillar}`} class="link">{pillar.title}</a> tools ·
        {tool.time} · Input: {tool.input}
      </p>
    </div>

    <div class:list={['container-x', formClass, 'mx-auto']}>
      <div class="card p-5 sm:p-8" id="tool">
        <slot name="form" />

        {
          !SITE.selfHosted && (
            <div class="mt-6 border-t border-line pt-5" data-email-optin data-source={`tool:${tool.slug}`} data-hj-suppress>
              <label class="label" for={`optin-${tool.slug}`}>Your email <span class="font-normal text-muted">(optional — updates on autopilot)</span></label>
              <div class="flex flex-col gap-2 sm:flex-row">
                <input id={`optin-${tool.slug}`} type="email" autocomplete="email" placeholder="you@business.com" class="field flex-1" data-optin-email />
              </div>
              <p class="help">Get follow-ups for this report, improvements to this tool and every new free tool — free, one-click unsubscribe. We send a confirmation email first.</p>
              <p class="hidden mt-2 text-sm font-semibold text-success" data-optin-ok>Check your inbox — click the confirmation link and you're set.</p>

              <div class="hidden mt-4 rounded-2xl border border-accent-strong bg-primary-tint p-5" role="dialog" aria-live="polite" data-optin-gate>
                <p class="text-[15px] font-semibold text-ink">Run it without an email? You'll miss the useful part on autopilot.</p>
                <p class="mt-1.5 text-[14px] leading-relaxed text-ink/80">
                  With an email you get this report's follow-ups, the guide for your fixes, and every new free tool as it ships — no account, nothing to buy, unsubscribe in one click. Without it, this run is all you get.
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <button type="button" class="btn-primary btn-sm" data-optin-add>Add my email</button>
                  <button type="button" class="btn-secondary btn-sm" data-optin-skip>Continue without email</button>
                </div>
              </div>
            </div>
          )
        }
      </div>
      <div id="tool-results" class="mt-8 scroll-mt-24">
        <slot name="results" />
        {
          !SITE.selfHosted && (
            <div id="after-use" class="mt-8 hidden" data-after-use>
              <div class="card grid gap-6 bg-navy p-6 text-white sm:p-8 md:grid-cols-[1.2fr_1fr] md:items-center">
                <div>
                  <p class="eyebrow text-accent">Free, forever — keep it that way for you</p>
                  <h2 class="mt-2 font-semibold tracking-tight text-2xl sm:text-3xl">Want new free tools and updates to this one?</h2>
                  <p class="mt-3 text-[15px] text-white/75">
                    Leave your email and you get one short message when a new free local SEO tool ships or this one improves. No account, nothing to buy, <strong class="text-white">unsubscribe any time with one click</strong>.
                  </p>
                  <p class="mt-3 text-[14px] text-white/60">Missing a tool? <a href="/request-a-tool/" class="font-semibold text-accent underline underline-offset-[3px]">Ask and we build it for free within 3 days.</a></p>
                </div>
                <form class="grid gap-3" data-subscribe data-source={`tool:${tool.slug}:after`} data-hj-suppress novalidate>
                  <label class="sr-only" for={`after-${tool.slug}`}>Email address</label>
                  <div class="flex flex-col gap-2 sm:flex-row">
                    <input id={`after-${tool.slug}`} type="email" name="email" required autocomplete="email" placeholder="you@business.com" class="field flex-1 text-ink" />
                    <button type="submit" class="btn-accent shrink-0">Keep me posted</button>
                  </div>
                  <p class="hidden text-sm font-semibold text-emerald-300" data-ok>Check your inbox — click the confirmation link and you're set.</p>
                  <p class="hidden text-sm font-semibold text-rose-300" data-err>Please enter a valid email address.</p>
                </form>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="container-x mt-20">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="h2 mt-2">How the {tool.shortName.toLowerCase()} works</h2>
        <ol class="mt-8 space-y-6">
          {
            tool.howItWorks.map((s, i) => (
              <li class="flex gap-4">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary text-[15px] font-extrabold text-white">{i + 1}</span>
                <div>
                  <h3 class="text-lg font-bold">{s.title}</h3>
                  <p class="mt-1 text-[15.5px] leading-relaxed text-muted">{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <slot name="method" />
      </div>
      <aside class="space-y-6">
        <div class="card p-6">
          <p class="eyebrow">Honest limits</p>
          <h3 class="mt-2 text-lg font-bold">What this tool can and cannot see</h3>
          <ul class="mt-4 space-y-3 text-[14.5px] leading-relaxed text-ink/85">
            {tool.limitations.map((l) => <li class="flex gap-2.5"><Icon name="info" size={17} class="mt-0.5 shrink-0 text-primary" />{l}</li>)}
          </ul>
        </div>
        {
          primaryGuide && (
            <a href={guideUrl(primaryGuide.id)} class="card card-hover block bg-navy p-6 text-white">
              <p class="eyebrow text-accent">Read the guide</p>
              <h3 class="mt-2 text-lg font-extrabold leading-snug">{primaryGuide.data.title}</h3>
              <p class="mt-2 text-[14.5px] text-white/75">{primaryGuide.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold">Open the guide <Icon name="arrow" size={16} /></span>
            </a>
          )
        }
      </aside>
    </div>
  </section>

  <section class="container-x mt-20">
    <Faq items={tool.faq} title={`${tool.shortName} — questions we get asked`} />
  </section>

  {
    relatedGuides.length > 0 && (
      <section class="container-x mt-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Keep learning</p>
            <h2 class="h2 mt-2">Guides that go with this tool</h2>
          </div>
          <a href="/guides/" class="link">All local SEO guides →</a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedGuides.map((g) => (
            <GuideCard slug={g!.id} title={g!.data.title} description={g!.data.description} pillar={g!.data.pillar} updated={g!.data.updated} />
          ))}
        </div>
      </section>
    )
  }

  <section class="container-x mt-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">More free local SEO tools</p>
        <h2 class="h2 mt-2">Next tool to run</h2>
      </div>
      <a href="/tools/" class="link">All free tools →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {relatedTools.map((t) => <ToolCard tool={t} variant="compact" />)}
    </div>
  </section>

  <section class="container-x mt-20">
    <EmailCapture source={`tool-${tool.slug}`} />
  </section>
</BaseLayout>

<script>
  import '../scripts/subscribe';
  import { installEmailGate } from '../scripts/email-gate';

  const gate = installEmailGate();
  document.addEventListener('locan:tool-run', () => {
    // Nudge again after the report only for visitors who chose to run without an email.
    if (gate.state() === 'skipped') document.querySelector<HTMLElement>('[data-after-use]')?.classList.remove('hidden');
  });
</script>
