---
import ToolShell from '../../components/ToolShell.astro';
import BusinessSearch from '../../components/BusinessSearch.astro';
import Icon from '../../components/Icon.astro';
import { getTool } from '../../data/tools';
import { hasGuide } from '../../data/guides';

const tool = getTool('local-business-schema-generator');

const typeGroups: [string, string[]][] = [
  ['General', ['LocalBusiness', 'Store', 'ProfessionalService']],
  ['Home services', ['Plumber', 'Electrician', 'HVACBusiness', 'RoofingContractor', 'GeneralContractor', 'HousePainter', 'Locksmith', 'MovingCompany', 'HomeAndConstructionBusiness']],
  ['Health', ['Dentist', 'Physician', 'MedicalClinic', 'Physiotherapy', 'Pharmacy', 'Optician', 'VeterinaryCare']],
  ['Food & drink', ['Restaurant', 'CafeOrCoffeeShop', 'Bakery', 'BarOrPub', 'FastFoodRestaurant', 'IceCreamShop']],
  ['Beauty', ['HairSalon', 'BeautySalon', 'NailSalon', 'DaySpa', 'TattooParlor']],
  ['Professional', ['Attorney', 'AccountingService', 'InsuranceAgency', 'RealEstateAgent', 'TravelAgency', 'FinancialService', 'EmploymentAgency']],
  ['Auto', ['AutoRepair', 'AutoDealer', 'AutoWash', 'AutoPartsStore', 'GasStation']],
  ['Retail', ['ClothingStore', 'Florist', 'FurnitureStore', 'HardwareStore', 'JewelryStore', 'PetStore', 'BikeStore', 'BookStore', 'ElectronicsStore', 'GroceryStore']],
  ['Other', ['Hotel', 'ExerciseGym', 'SportsActivityLocation', 'ChildCare', 'School', 'DryCleaningOrLaundry', 'ShoeStore']],
];

/** "CafeOrCoffeeShop" → "Cafe or coffee shop", "HVACBusiness" → "HVAC business" */
function humanize(type: string): string {
  return type
    .replace(/([a-z])([A-Z])/g, '$1 $2')
    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
    .split(' ')
    .map((w, i) => (/^[A-Z]{2,}$/.test(w) || i === 0 ? w : w.toLowerCase()))
    .join(' ');
}

// Google's opening-hours day index: 0 = Sunday … 6 = Saturday.
const days = [
  { name: 'Monday', gday: 1, open: '09:00', close: '17:00', closed: false },
  { name: 'Tuesday', gday: 2, open: '09:00', close: '17:00', closed: false },
  { name: 'Wednesday', gday: 3, open: '09:00', close: '17:00', closed: false },
  { name: 'Thursday', gday: 4, open: '09:00', close: '17:00', closed: false },
  { name: 'Friday', gday: 5, open: '09:00', close: '17:00', closed: false },
  { name: 'Saturday', gday: 6, open: '', close: '', closed: true },
  { name: 'Sunday', gday: 0, open: '', close: '', closed: true },
];

const platforms = [
  { name: 'WordPress', steps: 'Use a header/footer plugin (WPCode, Insert Headers and Footers) or paste it into your theme’s header.php. Rank Math and Yoast also accept custom schema per page.' },
  { name: 'Wix', steps: 'Settings → Custom code → Add code → paste → place in Head → apply to the relevant page.' },
  { name: 'Squarespace', steps: 'Settings → Advanced → Code Injection → Header.' },
  { name: 'Shopify', steps: 'Online Store → Themes → Edit code → theme.liquid → paste just before the closing head tag.' },
  { name: 'Webflow', steps: 'Page settings → Custom code → Inside head tag.' },
  { name: 'Plain HTML', steps: 'Paste it anywhere inside the head element of the page that represents your business.' },
];

const req = '<span class="text-danger" aria-hidden="true">*</span>';
---

<ToolShell tool={tool} formClass="max-w-4xl">
  <form slot="form" id="schForm" class="grid gap-8" data-hj-suppress novalidate autocomplete="off">
    <section class="grid gap-3">
      <BusinessSearch
        name="biz"
        label="Prefill from your Google Business Profile (optional)"
        placeholder="e.g. Radiant Plumbing Austin"
        required={false}
      />
      <p class="help -mt-1">Prefill uses our free API to read your public profile. Everything else — the form and the JSON-LD — stays in your browser.</p>
      <p id="schPrefillStatus" class="hidden text-sm text-ink/80" aria-live="polite"></p>
      <p id="schPrefillError" class="alert-error hidden" role="alert"></p>
    </section>

    <section>
      <h2 class="text-lg font-extrabold">Business</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="label" for="schType">Schema type <Fragment set:html={req} /></label>
          <select id="schType" class="field">
            {
              typeGroups.map(([group, types]) => (
                <optgroup label={group}>
                  {types.map((t) => (
                    <option value={t}>
                      {humanize(t)} ({t})
                    </option>
                  ))}
                </optgroup>
              ))
            }
          </select>
          <p class="help">Pick the most specific type that describes your core service. If nothing fits, keep LocalBusiness.</p>
        </div>
        <div>
          <label class="label" for="schName">Business name <Fragment set:html={req} /></label>
          <input id="schName" type="text" class="field" placeholder="Exactly as on your Google profile" maxlength="200" required />
        </div>
        <div>
          <label class="label" for="schTelephone">Telephone <Fragment set:html={req} /></label>
          <input id="schTelephone" type="tel" class="field" placeholder="+1 512 555 0100" maxlength="40" required />
          <p class="help">International format is best, e.g. +44 20 7946 0958.</p>
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="schDescription">Description</label>
          <textarea id="schDescription" class="field" rows="3" maxlength="750" placeholder="One or two sentences about what you do and where."></textarea>
        </div>
        <div>
          <label class="label" for="schUrl">Website URL</label>
          <input id="schUrl" type="url" class="field" placeholder="https://www.example.com/" maxlength="500" />
        </div>
        <div>
          <label class="label" for="schEmail">Email</label>
          <input id="schEmail" type="email" class="field" placeholder="hello@example.com" maxlength="200" />
        </div>
        <div>
          <label class="label" for="schPriceRange">Price range</label>
          <input id="schPriceRange" type="text" class="field" placeholder="$$" maxlength="20" />
          <p class="help">$ to $$$$, or a range like “€20–€60”.</p>
        </div>
        <div>
          <label class="label" for="schImage">Image URL</label>
          <input id="schImage" type="url" class="field" placeholder="https://www.example.com/storefront.jpg" maxlength="500" />
        </div>
        <div>
          <label class="label" for="schLogo">Logo URL</label>
          <input id="schLogo" type="url" class="field" placeholder="https://www.example.com/logo.png" maxlength="500" />
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-lg font-extrabold">Address &amp; location</h2>
      <p class="mt-1 text-sm text-muted">Keep it identical to your Google Business Profile — same spelling, same abbreviations.</p>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="label" for="schStreet">Street address <Fragment set:html={req} /></label>
          <input id="schStreet" type="text" class="field" placeholder="123 Main Street, Suite 4" maxlength="200" required />
        </div>
        <div>
          <label class="label" for="schLocality">City / locality <Fragment set:html={req} /></label>
          <input id="schLocality" type="text" class="field" placeholder="Austin" maxlength="100" required />
        </div>
        <div>
          <label class="label" for="schRegion">State / province / region</label>
          <input id="schRegion" type="text" class="field" placeholder="TX" maxlength="100" />
        </div>
        <div>
          <label class="label" for="schPostalCode">Postal code</label>
          <input id="schPostalCode" type="text" class="field" placeholder="78701" maxlength="20" />
        </div>
        <div>
          <label class="label" for="schCountry">Country code (2 letters) <Fragment set:html={req} /></label>
          <input id="schCountry" type="text" class="field uppercase" placeholder="US" maxlength="2" pattern="[A-Za-z]{2}" required />
        </div>
        <div>
          <label class="label" for="schLat">Latitude</label>
          <input id="schLat" type="number" step="any" min="-90" max="90" class="field" placeholder="30.267153" />
        </div>
        <div>
          <label class="label" for="schLng">Longitude</label>
          <input id="schLng" type="number" step="any" min="-180" max="180" class="field" placeholder="-97.743057" />
        </div>
      </div>
    </section>

    <section>
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-lg font-extrabold">Opening hours</h2>
          <p class="mt-1 text-sm text-muted">Tick “Closed” for days off. Leave both times empty to skip a day.</p>
        </div>
        <button type="button" id="schCopyMonday" class="btn-secondary btn-sm">Copy Monday to weekdays</button>
      </div>
      <div id="schHours" class="mt-4 grid gap-2">
        {
          days.map((d) => (
            <div class="grid grid-cols-[5.5rem_4.5rem_1fr_1fr] items-center gap-2 sm:grid-cols-[7rem_5.5rem_1fr_1fr]" data-day={d.name} data-gday={d.gday}>
              <span class="text-sm font-bold">{d.name}</span>
              <label class="flex items-center gap-1.5 text-xs font-semibold text-muted">
                <input type="checkbox" class="size-4 accent-primary" data-closed checked={d.closed} />
                Closed
              </label>
              <input type="time" class="field py-2" data-open value={d.open} disabled={d.closed} aria-label={`${d.name} opening time`} />
              <input type="time" class="field py-2" data-close value={d.close} disabled={d.closed} aria-label={`${d.name} closing time`} />
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="text-lg font-extrabold">Links &amp; extras</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label class="label" for="schSameAs">Social &amp; directory profiles (sameAs)</label>
          <textarea id="schSameAs" class="field font-mono text-[13.5px]" rows="4" placeholder="One URL per line: Facebook, Instagram, LinkedIn, Yelp, Google Maps…"></textarea>
        </div>
        <div class="sm:col-span-2">
          <label class="label" for="schHasMap">Google Maps URL (hasMap)</label>
          <input id="schHasMap" type="url" class="field" placeholder="https://maps.google.com/?cid=…" maxlength="500" />
        </div>
        <div>
          <label class="label" for="schAreaServed">Areas served</label>
          <input id="schAreaServed" type="text" class="field" placeholder="Austin, Round Rock, Cedar Park" maxlength="500" />
          <p class="help">Comma-separated city or town names.</p>
        </div>
        <div>
          <label class="label" for="schPayment">Payment accepted</label>
          <input id="schPayment" type="text" class="field" placeholder="Cash, Credit Card, Apple Pay" maxlength="200" />
        </div>
      </div>

      <details class="mt-5 rounded-xl border border-line p-4">
        <summary class="cursor-pointer text-sm font-semibold text-primary">Add an aggregateRating (optional — read the warning first)</summary>
        <p class="alert-warn mt-3">
          <strong>Only use ratings collected and displayed on YOUR website.</strong> Copying Google review counts violates Google’s structured data guidelines and can get your rich results removed.
        </p>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div>
            <label class="label" for="schRatingValue">Rating value (1–5)</label>
            <input id="schRatingValue" type="number" min="1" max="5" step="0.1" class="field" placeholder="4.8" />
          </div>
          <div>
            <label class="label" for="schReviewCount">Review count</label>
            <input id="schReviewCount" type="number" min="1" step="1" class="field" placeholder="37" />
          </div>
        </div>
      </details>
    </section>
  </form>

  <div slot="results" class="space-y-6" aria-live="polite">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="eyebrow">Live output</p>
          <h2 class="mt-1 text-2xl font-extrabold">Your LocalBusiness JSON-LD</h2>
          <p class="mt-1 text-sm text-muted">Updates as you type. Paste the whole block, including the script tags.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="schCopy" class="btn-primary btn-sm">Copy JSON-LD</button>
          <button type="button" id="schDownload" class="btn-secondary btn-sm">Download .json</button>
        </div>
      </div>

      <ul id="schValidation" class="mt-5 space-y-2 text-sm"></ul>

      <pre class="mt-5 max-h-[560px] overflow-auto rounded-xl border border-line bg-surface p-4 text-[13px] leading-relaxed text-ink"><code id="schCode">&lt;script type="application/ld+json"&gt;
<span id="schJson"></span>
&lt;/script&gt;</code></pre>

      <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
        <span class="font-bold">Test it:</span>
        <a class="btn-ghost btn-sm border border-line" href="https://search.google.com/test/rich-results" target="_blank" rel="noopener">
          Google Rich Results Test <Icon name="external" size={15} />
        </a>
        <a class="btn-ghost btn-sm border border-line" href="https://validator.schema.org/" target="_blank" rel="noopener">
          Schema.org validator <Icon name="external" size={15} />
        </a>
      </div>
    </div>

    <div class="card p-6 sm:p-8">
      <h2 class="h3 flex items-center gap-2"><Icon name="code" size={20} class="text-primary" /> Where to paste it</h2>
      <p class="mt-1 text-sm text-muted">
        Add it once, on the page that represents your business (homepage or contact page).{hasGuide('how-to-add-schema-markup-to-your-website') && <> Full walkthrough: <a href="/guides/how-to-add-schema-markup-to-your-website/" class="link">How to add schema markup to your website</a>.</>}
      </p>
      <dl class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          platforms.map((p) => (
            <div class="rounded-xl bg-surface p-4">
              <dt class="text-[15px] font-bold">{p.name}</dt>
              <dd class="mt-1 text-[14px] leading-relaxed text-ink/80">{p.steps}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-primary-soft bg-primary-tint p-5">
      <p class="text-[15px] text-ink/85">
        <strong>Next:</strong> make sure the profile you copied from is complete with the <a href="/tools/google-business-profile-optimizer/" class="link">GBP Optimizer</a>, then collect more reviews with the <a href="/tools/google-review-qr-code-generator/" class="link">Review QR Generator</a>.
      </p>
    </div>
  </div>

  <div slot="method" class="mt-10 rounded-2xl border border-line bg-surface p-6 text-[15px] leading-relaxed text-ink/85">
    <h3 class="text-lg font-bold">Why the exact subtype matters</h3>
    <p class="mt-2">
      Every subtype (Dentist, Plumber, HairSalon…) inherits everything from LocalBusiness, so nothing is lost by being specific — but a lot is gained. The type tells Google and AI assistants what kind of business the page is about without having to infer it from text, and it lines up with the primary category on your Google Business Profile. When the two agree, the entity behind your website and your map listing is easier to merge into one.
    </p>
    <h3 class="mt-6 text-lg font-bold">Keep NAP identical to your Google profile</h3>
    <p class="mt-2">
      Name, address and phone are the fields search engines use to match this markup with your Google Business Profile and every directory listing. Copy them exactly — the same suite number format, the same abbreviations, the same phone number — and update the markup whenever the profile changes. Consistency here is a trust signal; small mismatches are noise.
    </p>
  </div>
</ToolShell>

<script>
  import '../../scripts/tools/schema-generator';
</script>
