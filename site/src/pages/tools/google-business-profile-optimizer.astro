---
import ToolShell from '../../components/ToolShell.astro';
import BusinessSearch from '../../components/BusinessSearch.astro';
import Icon from '../../components/Icon.astro';
import { getTool } from '../../data/tools';

const tool = getTool('google-business-profile-optimizer');
---

<ToolShell tool={tool}>
  <form slot="form" id="gbpForm" class="grid gap-5" data-hj-suppress novalidate>
    <BusinessSearch name="biz" label="Your business on Google" placeholder="e.g. Radiant Plumbing Austin" help="Start typing and pick your business from the suggestions. You can also paste a Google Maps link below instead." />
    <details class="text-sm">
      <summary class="cursor-pointer font-semibold text-primary">Paste a Google Maps link instead</summary>
      <input id="gbpUrl" type="url" class="field mt-3" placeholder="https://maps.google.com/?cid=… or https://goo.gl/maps/…" />
    </details>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <button type="submit" id="gbpSubmit" class="btn-primary sm:min-w-56">
        <span data-label>Analyze my profile</span>
        <span class="spinner hidden" data-spinner></span>
      </button>
      <p class="text-xs text-muted">Read-only. We never change anything on your profile.</p>
    </div>
    <p id="gbpError" class="alert-error hidden" role="alert"></p>
  </form>

  <div slot="results" id="gbpResults" class="hidden space-y-6" aria-live="polite">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <div class="score-ring grid size-32 shrink-0 place-items-center rounded-full" id="gbpRing">
          <div class="grid size-[104px] place-items-center rounded-full bg-white text-center">
            <div>
              <div class="text-4xl font-extrabold leading-none text-ink" id="gbpScore">–</div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-muted">/100</div>
            </div>
          </div>
        </div>
        <div class="min-w-0 flex-1">
          <p class="eyebrow">Profile audit</p>
          <h2 class="mt-1 text-2xl font-extrabold" id="gbpName">Your Google Business Profile</h2>
          <p class="text-sm text-muted" id="gbpAddress"></p>
          <div class="mt-3 flex flex-wrap gap-2" id="gbpMeta"></div>
          <p class="mt-3 text-[15px] text-ink/80"><span class="font-bold" id="gbpGrade"></span> <span id="gbpSummary"></span></p>
        </div>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="card p-6">
        <h3 class="h3 flex items-center gap-2"><Icon name="audit" size={20} class="text-primary" /> What we checked</h3>
        <ul id="gbpChecks" class="mt-4 space-y-3"></ul>
      </div>
      <div class="card p-6">
        <h3 class="h3 flex items-center gap-2"><Icon name="bolt" size={20} class="text-primary" /> Do this first</h3>
        <ol id="gbpFixes" class="mt-4 list-decimal space-y-2 pl-5 text-[15px] text-ink/85"></ol>
      </div>
    </div>

    <div id="gbpAi" class="hidden space-y-6">
      <div class="card p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <h3 class="h3 flex items-center gap-2"><Icon name="sparkle" size={20} class="text-primary" /> Optimised description</h3>
            <p class="mt-1 text-sm text-muted">Drafted from your public profile. Edit anything that is not true for your business before pasting it into Google.</p>
          </div>
          <button type="button" class="btn-secondary btn-sm" data-copy="#gbpDescription">Copy</button>
        </div>
        <p id="gbpDescription" class="mt-4 rounded-xl bg-surface p-4 text-[15.5px] leading-relaxed text-ink/90"></p>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="card p-6">
          <h3 class="h3">Google Post ideas</h3>
          <ul id="gbpPosts" class="mt-4 space-y-2 text-[15px] text-ink/85"></ul>
        </div>
        <div class="card p-6">
          <h3 class="h3">Long-tail keywords to work into your profile</h3>
          <div id="gbpKeywords" class="mt-4 flex flex-wrap gap-2"></div>
          <h3 class="h3 mt-8">Local citation ideas</h3>
          <ul id="gbpCitations" class="mt-3 list-disc space-y-1.5 pl-5 text-[15px] text-ink/85"></ul>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="card p-6">
          <h3 class="h3">Local FAQs to add</h3>
          <div id="gbpFaqs" class="mt-4 space-y-4"></div>
        </div>
        <div class="card p-6">
          <h3 class="h3">Review reply templates</h3>
          <p class="mt-1 text-sm text-muted">Need a reply for a specific review? Use the <a href="/tools/ai-review-response-generator/" class="link">AI Review Response Generator</a>.</p>
          <div id="gbpReplies" class="mt-4 space-y-3"></div>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-primary-soft bg-primary-tint p-5">
      <p class="text-[15px] text-ink/85"><strong>Next:</strong> see where this profile actually ranks with the <a href="/tools/local-rank-checker/" class="link">Local Rank Checker</a>, then fix relevance with the <a href="/tools/gbp-category-optimizer/" class="link">Category Optimizer</a>.</p>
      <button type="button" id="gbpReset" class="btn-secondary btn-sm">Check another business</button>
    </div>
  </div>

  <div slot="method" class="mt-10 rounded-2xl border border-line bg-surface p-6 text-[15px] leading-relaxed text-ink/85">
    <h3 class="text-lg font-bold">How the score is calculated</h3>
    <p class="mt-2">Six checks, weighted by how often they decide who wins a local search: reviews (25 points, 10+ needed), photos (20, five or more), website (15), opening hours (15), category (15) and phone number (10). 90+ is an A; below 60 needs work. Scores compare you against completeness, not against competitors — use the Local Rank Checker for that.</p>
  </div>
</ToolShell>

<script>
  import '../../scripts/tools/gbp-optimizer';
</script>
