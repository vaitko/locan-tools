---
import ToolShell from '../../components/ToolShell.astro';
import BusinessSearch from '../../components/BusinessSearch.astro';
import Icon from '../../components/Icon.astro';
import { getTool } from '../../data/tools';

const tool = getTool('local-rank-checker');

// Segmented pill: the radio is visually hidden, the label styles itself from :has(:checked).
const pill =
  'inline-flex cursor-pointer select-none items-center gap-1.5 rounded-full border border-line bg-white px-4 py-2 text-sm font-bold text-ink transition-colors hover:bg-surface has-checked:border-primary has-checked:bg-primary has-checked:text-white has-checked:hover:bg-primary-hover has-[:focus-visible]:ring-4 has-[:focus-visible]:ring-primary/20';
---

<ToolShell tool={tool}>
  <form slot="form" id="rankForm" class="grid gap-5" data-hj-suppress novalidate>
    <BusinessSearch
      name="biz"
      label="Your business on Google"
      placeholder="e.g. Radiant Plumbing Austin"
      help="Start typing and pick your business from the suggestions — the grid is built around its exact location."
      required
    />
    <div>
      <label class="label" for="rankKeyword">Keyword to check</label>
      <input id="rankKeyword" type="text" class="field" placeholder="e.g. emergency plumber austin" maxlength="80" autocomplete="off" required />
      <p class="help">One keyword per check. Start with your main service + city, then the generic head term.</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <fieldset>
        <legend class="label">Grid size</legend>
        <div class="flex flex-wrap gap-2">
          <label class={pill}>
            <input type="radio" name="gridSize" value="3" class="sr-only" checked />
            3×3 <span class="font-semibold opacity-75">· 9 points</span>
          </label>
          <label class={pill}>
            <input type="radio" name="gridSize" value="5" class="sr-only" />
            5×5 <span class="font-semibold opacity-75">· 25 points</span>
          </label>
        </div>
        <p class="help">5×5 uses 3× your daily limit.</p>
      </fieldset>
      <fieldset>
        <legend class="label">Spacing</legend>
        <div class="flex flex-wrap gap-2">
          <label class={pill}><input type="radio" name="spacingKm" value="0.5" class="sr-only" /> 0.5 km</label>
          <label class={pill}><input type="radio" name="spacingKm" value="1" class="sr-only" checked /> 1 km</label>
          <label class={pill}><input type="radio" name="spacingKm" value="2" class="sr-only" /> 2 km</label>
        </div>
        <p class="help">Spacing is the distance between neighbouring grid points. A 3×3 grid at 1 km covers 2 km across your location.</p>
      </fieldset>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <button type="submit" id="rankSubmit" class="btn-primary sm:min-w-56">
        <span data-label>Check my local rankings</span>
        <span class="spinner hidden" data-spinner></span>
      </button>
      <p class="text-xs text-muted">Read-only. We never change anything on your profile.</p>
    </div>
    <p id="rankError" class="alert-error hidden" role="alert"></p>
  </form>

  <div slot="results" id="rankResults" class="hidden space-y-6" aria-live="polite">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <p class="eyebrow">Ranking heat map</p>
          <h2 class="mt-1 text-2xl font-extrabold" id="rankBizName">Your business</h2>
          <p class="text-sm text-muted" id="rankBizAddress"></p>
        </div>
        <div class="flex flex-wrap gap-2 sm:justify-end">
          <span class="tag tag-primary" id="rankKeywordTag"></span>
          <span class="tag" id="rankGridTag"></span>
        </div>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div class="card p-6">
        <h2 class="h3 flex items-center gap-2"><Icon name="grid" size={20} class="text-primary" /> Where you rank</h2>
        <p class="mt-1 text-sm text-muted">Your position in the results when someone searches from each point.</p>
        <div id="rankGrid" class="mx-auto mt-5 grid w-full max-w-md gap-2" aria-label="Ranking heat map"></div>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold text-muted">
          <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-sm bg-success"></span> 1–3</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-sm bg-warning"></span> 4–10</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-sm bg-[#F97316]"></span> 11–20</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-sm bg-[#CBD5E1]"></span> 20+ (not found)</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-sm border border-line bg-line"></span> — check failed</span>
        </div>
        <p class="mt-3 text-xs text-muted">North is up; each cell is one searcher location. Hover a cell for its coordinates.</p>
      </div>

      <div class="space-y-6">
        <div class="card p-6">
          <h2 class="h3">Summary</h2>
          <div id="rankSummary" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
        </div>
        <div id="rankVerdict" class="rounded-2xl border border-line bg-surface p-6"></div>
      </div>
    </div>

    <div class="card p-6">
      <h2 class="h3">Who takes your place</h2>
      <p class="mt-1 text-sm text-muted">Businesses that appeared most often across the grid, with their average position.</p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[480px] text-left text-[15px]">
          <thead>
            <tr class="text-xs font-bold uppercase tracking-wider text-muted">
              <th scope="col" class="pb-2 pr-3">#</th>
              <th scope="col" class="pb-2 pr-3">Business</th>
              <th scope="col" class="pb-2 pr-3">Appearances</th>
              <th scope="col" class="pb-2">Avg. position</th>
            </tr>
          </thead>
          <tbody id="rankCompetitors"></tbody>
        </table>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-primary-soft bg-primary-tint p-5">
      <p class="text-[15px] text-ink/85"><strong>Tip:</strong> check the generic head term and your top three services — the pattern across keywords tells you more than any single grid.</p>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="rankAnother" class="btn-primary btn-sm">Check another keyword</button>
        <button type="button" id="rankReset" class="btn-secondary btn-sm">Change business</button>
      </div>
    </div>
  </div>

  <div slot="method" class="mt-10 rounded-2xl border border-line bg-surface p-6 text-[15px] leading-relaxed text-ink/85">
    <h3 class="text-lg font-bold">How the heat map is measured</h3>
    <p class="mt-2">
      For every grid point we run a Google Places text search for your keyword, biased to that point's coordinates — the same way Google weighs a searcher's position — and record the 1-based position of your place ID among the top 20 results. Results track Google Maps closely, but Maps also personalises by search history, device and time of day, so read the pattern across cells rather than a single square. Any ranking beyond position 20 shows as 20+.
    </p>
  </div>
</ToolShell>

<script>
  import '../../scripts/tools/rank-checker';
</script>
