# Self-hosted Locan — copy to .env, fill in the keys you have, then `docker compose up --build`.
GOOGLE_PLACES_API_KEY=
# AI provider: replicate (default, runs openai/gpt-5-nano) or openai
# LLM_MODEL must be a model name the chosen provider accepts (Replicate: owner/name; OpenAI: gpt-4o-mini; Ollama: the local model tag).
LLM_PROVIDER=replicate
LLM_MODEL=openai/gpt-5-nano
OPENAI_API_KEY=
OPENAI_BASE_URL=
REPLICATE_API_TOKEN=
# Port the site is published on (http://localhost:$LOCAN_PORT)
LOCAN_PORT=8080

# --- Replicate (default) ---
# LLM_PROVIDER=replicate
# REPLICATE_API_TOKEN=r8_...

# --- OpenAI direct ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# OPENAI_API_KEY=
