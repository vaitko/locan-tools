# Local development only — never commit real values (file is git-ignored)
APP_ENV=dev
# Self-hosted mode: no quotas, subscribe endpoints disabled, open CORS. See docker-compose.yml.
SELF_HOSTED=false
OPENAI_API_KEY=
# AI provider: replicate (default, runs openai/gpt-5-nano) or openai
# LLM_MODEL must be a model name the chosen provider accepts (Replicate: owner/name; OpenAI: gpt-4o-mini; Ollama: the local model tag).
LLM_PROVIDER=replicate
LLM_MODEL=openai/gpt-5-nano
# LLM_PROVIDER=openai + OPENAI_API_KEY=sk-... + LLM_MODEL=gpt-4o-mini calls OpenAI directly.
# LLM_PROVIDER=openai + OPENAI_BASE_URL=http://host.docker.internal:11434/v1 + LLM_MODEL=<ollama model> runs the text tools against a local Ollama/LM Studio/OpenRouter server.
OPENAI_BASE_URL=
REPLICATE_API_TOKEN=
GOOGLE_PLACES_API_KEY=
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322
# Leave empty locally: quotas stay in memory, subscribe becomes a no-op
QUOTA_TABLE=
ALERT_EMAIL=
ALERT_FROM=
ORIGIN_VERIFY_SECRET=
